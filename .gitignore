# Secrets — a safety net, not the control.
# Real secrets live in ~/.config/conclave/secrets.env, outside this repo.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.env

# Binaries
/bin/
/dist/
conclave-server
conclave-worker
*.exe

# Go build and test output
*.test
*.out
coverage.*
/vendor/

# Personal study notes. Kept on disk only; never pushed. Everything else
# under docs/ is tracked, because tickets and agents read it.
/docs/notes/

# Owner configuration for real repositories. The shipped deploy/*.yaml
# files are placeholders that fail validation; the filled-in copies live
# here, because this repository is public and they name private ones.
/deploy/local/

# Local runtime state
/artifacts/
/tmp/
/data/
/.pgdata/
*.db
*.sqlite

# Claude Code — settings.json is committed; personal overrides are not
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local tooling
.direnv/
.tool-versions.local